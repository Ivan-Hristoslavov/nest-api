# Copy to .env and fill in real values: cp .env.example .env

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true
CORS_ORIGINS=*
LOG_LEVEL=debug

# --- API key authentication ------------------------------------------------
API_KEY_HEADER=x-api-key
API_KEY=replace-with-a-long-random-string
API_KEYS=replace-with-a-long-random-string

# --- Supabase PostgreSQL ---------------------------------------------------
# Dashboard -> Project -> Connect -> ORMs (copy host/port/user verbatim)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_NAME=postgres
DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=10
DB_POOL_MIN_SIZE=2
DB_CONNECT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=600000
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Supabase project ------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Scraper ---------------------------------------------------------------
SCRAPER_ENABLED=true
SCRAPER_CRON=0 * * * *
SCRAPER_BATCH_SIZE=25
SCRAPER_CONCURRENCY=5
SCRAPER_TIMEOUT_MS=10000
SCRAPER_MIN_DELAY_MS=150
SCRAPER_ALERT_THRESHOLD_PERCENT=5

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
