# Copy to .env and fill in real values: cp .env.example .env

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true
CORS_ORIGINS=*
LOG_LEVEL=debug

# --- API key authentication ------------------------------------------------
API_KEY_HEADER=x-api-key
API_KEY=replace-with-a-long-random-string
API_KEYS=replace-with-a-long-random-string

# --- Billing (merchant of record) ------------------------------------------
# paddle | lemonsqueezy
BILLING_PROVIDER=paddle
# Paddle: Developer Tools -> Notifications -> your endpoint -> secret key.
PADDLE_WEBHOOK_SECRET=
# Lemon Squeezy: Settings -> Webhooks -> signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Reject Paddle signatures older than this, in seconds (replay protection).
BILLING_SIGNATURE_TOLERANCE_SECONDS=300
# How long a resolved customer key is cached in memory, in milliseconds.
API_KEY_CACHE_TTL_MS=30000

# --- Supabase PostgreSQL ---------------------------------------------------
# Dashboard -> Project -> Connect -> ORMs (copy host/port/user verbatim)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_NAME=postgres
DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Kept small on purpose. Supabase's session-mode pooler allows 15 clients in
# total, and a deploy runs the old container and the new one side by side —
# so anything above 7 makes the new one fail to start with EMAXCONNSESSION
# while the old one is still holding its share. Leave room for a laptop too.
DB_POOL_SIZE=5
DB_POOL_MIN_SIZE=2
DB_CONNECT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=600000
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Supabase project ------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Scraper ---------------------------------------------------------------
SCRAPER_ENABLED=true
SCRAPER_CRON=0 * * * *
SCRAPER_BATCH_SIZE=25
SCRAPER_CONCURRENCY=5
SCRAPER_TIMEOUT_MS=5000
SCRAPER_MIN_DELAY_MS=150
SCRAPER_ALERT_THRESHOLD_PERCENT=5

# --- Scraper driver --------------------------------------------------------
# simulation = generated price movement, no network (safe default for demos)
# http       = fetch and parse real competitor pages
SCRAPER_DRIVER=simulation
SCRAPER_USER_AGENT=PriceIntelligenceBot/1.0 (+https://example.com/bot; contact@example.com)
# Honour robots.txt and its Crawl-delay. Leave on: it is what keeps the
# crawler tolerated rather than blocked.
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BASE_DELAY_MS=1000

# --- Alerting --------------------------------------------------------------
ALERTS_ENABLED=true
# Slack incoming webhook. Leave empty to store alerts without sending them.
ALERT_SLACK_WEBHOOK_URL=
# Generic outbound webhook. Payloads are signed with HMAC-SHA256 in the
# X-Signature header when ALERT_WEBHOOK_SECRET is set.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_DELIVERY_TIMEOUT_MS=8000
# Suppress repeat alerts of the same type for the same listing, in minutes.
ALERT_COOLDOWN_MINUTES=60

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120


# --- Outgoing email --------------------------------------------------------
# The one thing that turns a payment into a customer: the API key is stored as
# a hash, so the plaintext exists for a single moment inside the webhook that
# created it. Leave SMTP_HOST empty to run without mail — the key is then
# issued and reported in the response for an operator to deliver by hand.
#
# Gmail needs an app-specific password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Implicit TLS. Defaults to true on 465, false elsewhere.
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Stoclify <billing@example.com>

# Put in the email beside the key, so the customer knows where to paste it.
APP_PUBLIC_URL=http://localhost:3000
SUPPORT_EMAIL=

# --- Stripe ----------------------------------------------------------------
# Used when BILLING_PROVIDER=stripe. Create the plans as products in the Stripe
# dashboard and paste *their* price ids here: an id from another product will
# charge the wrong amount for the wrong thing, and nothing in the flow notices.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > add endpoint {APP_PUBLIC_URL}/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# --- Hosted checkout links --------------------------------------------------
# An alternative to the price ids above, and the simpler one: a Payment Link is
# a public URL, so the pricing buttons work without a secret key in the
# application at all. A link wins over a price id where both are set.
#
# Create them in Dashboard > Payment links, one per plan, each pointing at that
# plan's recurring price. Collect a billing address and a VAT number on each —
# the prices are quoted without VAT, and a business buyer needs its number on
# the invoice. Stripe issues an invoice with a downloadable PDF on every
# billing cycle by itself; there is nothing to build for that.
#
# Whatever payment methods are switched on in Dashboard > Settings > Payment
# methods appear on these pages automatically — Apple Pay and Google Pay need
# nothing further, because the page is hosted on stripe.com rather than here.
CHECKOUT_LINK_STARTER=
CHECKOUT_LINK_PRO=
CHECKOUT_LINK_BUSINESS=
# A one-off price for more AI comparisons, sold from the dashboard.
CHECKOUT_LINK_TOPUP=

# --- Resend (outgoing email over HTTPS) -------------------------------------
# Set this and mail goes through Resend's REST API instead of SMTP. Leave it
# empty and the SMTP settings above are used, which is what a laptop wants.
#
# It exists because hosting platforms — Railway, Render, Fly and most of their
# neighbours — close outbound 25, 465 and 587 so their addresses cannot be used
# to send spam. That closes SMTP to Gmail *and* to Resend's own SMTP endpoint.
# Port 443 is the one that is open.
#
# The sender in SMTP_FROM must be an address at a domain verified in Resend.
# Until you have one, `onboarding@resend.dev` works and can only write to the
# address that owns the Resend account — enough to test, not enough to sell.
RESEND_API_KEY=

# --- Observability ----------------------------------------------------------
# Where crashes go. Empty means they only reach the log, which is fine on a
# laptop and not fine once there are customers.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Two-factor authentication ----------------------------------------------
# Encrypts the stored TOTP secrets, and is deliberately NOT in the database:
# a dump of the table is useless without it, which is the whole reason a
# second factor survives a leak. Without this set, customers cannot switch
# two-factor on — refusing is honest, storing secrets in the open is not.
#   openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# --- Price history retention ------------------------------------------------
# Every observation is kept for HISTORY_FULL_DAYS, then thinned to one reading
# per listing per day, then dropped entirely past HISTORY_KEEP_DAYS. Without
# this the table grows without limit: 2000 watched articles across 4 suppliers,
# checked hourly, is roughly 70 million rows a year.
HISTORY_FULL_DAYS=30
HISTORY_KEEP_DAYS=400

# --- Politeness toward supplier websites -------------------------------------
# Two different promises, and they are easy to confuse.
#
# SCRAPER_MIN_DELAY_MS controls *rate* — the gap between two requests to one
# host. A shop's own `Crawl-delay` overrides it when it asks for more.
#
# SCRAPER_HOST_DAILY_BUDGET controls *volume*, which is what a site's
# protection actually counts. Spacing half a million requests a second apart is
# still half a million requests a day from one address. Listings that do not fit
# the budget wait for tomorrow: a price one day old is survivable, being
# blocked is not. 0 disables the ceiling.
#
# SCRAPER_SHARED_FETCH_MS is the one that matters most as customers arrive.
# Five hundred buyers watching the same cable at the same shop is one page, not
# five hundred — without it the request count scales with customers rather than
# with articles. The share is keyed on the URL *and* the selector, so two
# customers reading different prices off one page still get their own.
SCRAPER_MIN_DELAY_MS=1000
SCRAPER_HOST_DAILY_BUDGET=2000
SCRAPER_SHARED_FETCH_MS=1800000
