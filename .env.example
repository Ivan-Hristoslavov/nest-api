# Copy to .env and fill in real values: cp .env.example .env

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true
CORS_ORIGINS=*
LOG_LEVEL=debug

# --- API key authentication ------------------------------------------------
API_KEY_HEADER=x-api-key
API_KEY=replace-with-a-long-random-string
API_KEYS=replace-with-a-long-random-string

# --- Billing (merchant of record) ------------------------------------------
# paddle | lemonsqueezy
BILLING_PROVIDER=paddle
# Paddle: Developer Tools -> Notifications -> your endpoint -> secret key.
PADDLE_WEBHOOK_SECRET=
# Lemon Squeezy: Settings -> Webhooks -> signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Reject Paddle signatures older than this, in seconds (replay protection).
BILLING_SIGNATURE_TOLERANCE_SECONDS=300
# How long a resolved customer key is cached in memory, in milliseconds.
API_KEY_CACHE_TTL_MS=30000

# --- Supabase PostgreSQL ---------------------------------------------------
# Dashboard -> Project -> Connect -> ORMs (copy host/port/user verbatim)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_NAME=postgres
DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=10
DB_POOL_MIN_SIZE=2
DB_CONNECT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=600000
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Supabase project ------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Scraper ---------------------------------------------------------------
SCRAPER_ENABLED=true
SCRAPER_CRON=0 * * * *
SCRAPER_BATCH_SIZE=25
SCRAPER_CONCURRENCY=5
SCRAPER_TIMEOUT_MS=5000
SCRAPER_MIN_DELAY_MS=150
SCRAPER_ALERT_THRESHOLD_PERCENT=5

# --- Scraper driver --------------------------------------------------------
# simulation = generated price movement, no network (safe default for demos)
# http       = fetch and parse real competitor pages
SCRAPER_DRIVER=simulation
SCRAPER_USER_AGENT=PriceIntelligenceBot/1.0 (+https://example.com/bot; contact@example.com)
# Honour robots.txt and its Crawl-delay. Leave on: it is what keeps the
# crawler tolerated rather than blocked.
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BASE_DELAY_MS=1000

# --- Alerting --------------------------------------------------------------
ALERTS_ENABLED=true
# Slack incoming webhook. Leave empty to store alerts without sending them.
ALERT_SLACK_WEBHOOK_URL=
# Generic outbound webhook. Payloads are signed with HMAC-SHA256 in the
# X-Signature header when ALERT_WEBHOOK_SECRET is set.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_DELIVERY_TIMEOUT_MS=8000
# Suppress repeat alerts of the same type for the same listing, in minutes.
ALERT_COOLDOWN_MINUTES=60

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120


# --- Outgoing email --------------------------------------------------------
# The one thing that turns a payment into a customer: the API key is stored as
# a hash, so the plaintext exists for a single moment inside the webhook that
# created it. Leave SMTP_HOST empty to run without mail — the key is then
# issued and reported in the response for an operator to deliver by hand.
#
# Gmail needs an app-specific password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Implicit TLS. Defaults to true on 465, false elsewhere.
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PriceGuard <billing@example.com>

# Put in the email beside the key, so the customer knows where to paste it.
APP_PUBLIC_URL=http://localhost:3000
SUPPORT_EMAIL=

# --- Stripe ----------------------------------------------------------------
# Used when BILLING_PROVIDER=stripe. Create the plans as products in the Stripe
# dashboard and paste *their* price ids here: an id from another product will
# charge the wrong amount for the wrong thing, and nothing in the flow notices.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > add endpoint {APP_PUBLIC_URL}/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
